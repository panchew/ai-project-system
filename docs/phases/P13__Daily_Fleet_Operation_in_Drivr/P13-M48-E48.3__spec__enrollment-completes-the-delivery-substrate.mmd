flowchart LR
  INIT["bin/ai-project-init<br/>+ final commit amendment"]
  ENROLL["bin/ai-project-enroll<br/>query · --remote · --local-only"]
  REJECT["credential-bearing URL?<br/>(--remote or existing origin)"]
  INVALID["invalid-url<br/>remote: null (redacted)"]
  VERIFY["THREE-PART VERIFICATION (final HEAD)<br/>tracking recorded · branch pushed · ref equality"]
  READY["delivery-ready (detail: verified)"]
  LOCAL["local-only — durable record<br/>(detail: local-only, NON-delivery-ready)"]
  ABSENT["absent"]
  CRED_ABS["credential-absent"]
  REFUSE["authenticated-refusal"]
  VFAIL["verification-failure"]
  UNDET["undetermined"]

  INIT --> ENROLL
  ENROLL -- "query" --> ABSENT
  ENROLL -- "--remote" --> REJECT
  REJECT -- "yes" --> INVALID
  REJECT -- "no" --> VERIFY
  VERIFY -- all three --> READY
  VERIFY -- any fails --> VFAIL
  ENROLL -- "--local-only" --> LOCAL
  VERIFY -- "no credentials" --> CRED_ABS
  VERIFY -- "remote refused" --> REFUSE
  VERIFY -- "cannot determine" --> UNDET

  classDef a fill:#1e3a5f,stroke:#93c5fd,color:#fff
  class INIT,ENROLL,REJECT,INVALID,VERIFY,READY,LOCAL,ABSENT,CRED_ABS,REFUSE,VFAIL,UNDET a

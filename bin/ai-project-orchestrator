#!/usr/bin/env python3
import os
import sys
import json
import subprocess
import yaml
import signal
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
QUEUE_DIR = PROJECT_ROOT / ".ai-project" / "queue"
LOCK_FILE = PROJECT_ROOT / ".ai-project" / "locks" / "execution.lock"
YML_CONFIG = PROJECT_ROOT / ".ai-project.yml"
MAX_RETRIES = 3

DEFAULT_MODELS = {
    "hq": "remote:gpt-4o",
    "phase": "remote:claude-3-5-sonnet",
    "milestone": "remote:claude-3-5-sonnet",
    "epic_dev": "local:llama3:8b",
    "epic_qa": "local:qwen2.5-coder:7b"
}

def signal_handler(signum, frame):
    print(f"\n[!] Received signal {signum}. Cleaning up and exiting...", file=sys.stderr)
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
            print("[✓] Lockfile removed successfully.", file=sys.stderr)
        except Exception as e:
            print(f"[!] Failed to remove lockfile: {e}", file=sys.stderr)
    sys.exit(128 + signum)

# Register signals for clean lockfile removal
signal.signal(signal.SIGINT, signal_handler)
signal.signal(signal.SIGTERM, signal_handler)


def load_yml_config():
    """Loads and returns the model mapping from .ai-project.yml if present."""
    if not YML_CONFIG.exists():
        return {"models": DEFAULT_MODELS}
    try:
        with open(YML_CONFIG, 'r') as f:
            data = yaml.safe_load(f)
            if data and "models" in data:
                # Merge defaults with custom definitions to support partial configurations
                merged = DEFAULT_MODELS.copy()
                merged.update(data["models"])
                return {"models": merged}
    except Exception as e:
        print(f"[!] Warning: Failed to parse .ai-project.yml models. Using defaults. Error: {e}", file=sys.stderr)
    return {"models": DEFAULT_MODELS}

def load_json_trigger(file_name):
    path = QUEUE_DIR / file_name
    if not path.exists():
        return None
    try:
        with open(path, 'r') as f:
            return json.load(f)
    except Exception as e:
        print(f"[!] Error reading trigger file {file_name}: {e}", file=sys.stderr)
        return None

def run_in_sandbox(image, command, active_model):
    """Mounts the project root inside an isolated Docker sandbox container, injecting active model metadata."""
    # Pass active model as an environment variable to allow the container scripts to route appropriately
    docker_cmd = [
        "docker", "run", "--rm",
        "-e", f"AI_PROJECT_ACTIVE_MODEL={active_model}",
        "-v", f"{PROJECT_ROOT}:/workspace",
        "-w", "/workspace",
        image,
        "sh", "-c", command
    ]
    try:
        result = subprocess.run(docker_cmd, capture_output=True, text=True)
        return result.returncode, result.stdout, result.stderr
    except FileNotFoundError:
        # Fallback to local execution if Docker is not available in current environment
        print("[!] Docker is not installed or available. Executing locally with model environment...")
        env = os.environ.copy()
        env["AI_PROJECT_ACTIVE_MODEL"] = active_model
        result = subprocess.run(command, shell=True, env=env, capture_output=True, text=True)
        return result.returncode, result.stdout, result.stderr

def handle_epic_execution(trigger, models_config):
    epic_id = trigger.get("epic_id", "unknown")
    spec_path = trigger.get("epic_spec_path", "")
    sandbox_image = trigger.get("sandbox_env", "alpine:latest")
    validation_cmd = trigger.get("validation_command", "npm run lint && npm test")
    dev_cmd = trigger.get("dev_command", "./bin/run-dev-agent")
    run_dev_initially = trigger.get("run_dev_initially", False) or trigger.get("dev_initially", False)
    
    # Resolve Hybrid Model Selection
    dev_model = models_config.get("epic_dev", DEFAULT_MODELS["epic_dev"])
    qa_model = models_config.get("epic_qa", DEFAULT_MODELS["epic_qa"])
    
    print(f"[*] Starting unattended validation loop for Epic {epic_id}...")
    print(f"[*] Hybrid Model Mapping:")
    print(f"    - Developer Role: {dev_model}")
    print(f"    - QA Tester Role: {qa_model}")
    print(f"[*] Sandbox environment: {sandbox_image}")
    print(f"[*] Developer Command: {dev_cmd}")
    print(f"[*] Validation Command: {validation_cmd}")
    print(f"[*] Run Dev Initially: {run_dev_initially}")
    
    # Dev-QA Closed Recursion Loop
    feedback_file = PROJECT_ROOT / ".ai-project" / "feedback.json"
    for attempt in range(1, MAX_RETRIES + 1):
        print(f"[*] Loop Attempt {attempt}/{MAX_RETRIES}...")
        
        # Run dev_command (only if attempt > 1 OR if explicitly flagged to run initially)
        if (attempt > 1) or run_dev_initially:
            print(f"[*] Running developer command inside sandbox (active model: {dev_model}): {dev_cmd}")
            dev_code, dev_out, dev_err = run_in_sandbox(sandbox_image, dev_cmd, active_model=dev_model)
            print(f"[*] Developer command finished with exit code: {dev_code}")
            if dev_code != 0:
                print(f"[!] Warning: Developer command failed with exit code {dev_code}", file=sys.stderr)
        
        # Run validation_command inside sandbox under epic_qa model configuration
        print(f"[*] Running validation command inside sandbox (active model: {qa_model}): {validation_cmd}")
        val_code, stdout, stderr = run_in_sandbox(sandbox_image, validation_cmd, active_model=qa_model)
        
        if val_code == 0:
            print(f"[✓] Epic {epic_id} validation passed successfully on attempt {attempt}!")
            
            # Clean up .ai-project/feedback.json
            if feedback_file.exists():
                try:
                    feedback_file.unlink()
                    print("[✓] Cleaned up feedback.json")
                except Exception as e:
                    print(f"[!] Failed to clean up feedback.json: {e}", file=sys.stderr)
            
            # Automate staging and commit
            print("[*] Staging and committing changes...")
            subprocess.run(["git", "add", "."], cwd=PROJECT_ROOT)
            subprocess.run(["git", "commit", "-m", f"feat: programmatically implement Epic {epic_id} deliverables\n\nResolved via Developer: {dev_model} and QA: {qa_model}"], cwd=PROJECT_ROOT)
            
            # Remove trigger file from queue
            trigger_file = QUEUE_DIR / "04_epic.json"
            if trigger_file.exists():
                try:
                    trigger_file.unlink()
                    print("[✓] Removed trigger file 04_epic.json")
                except Exception as e:
                    print(f"[!] Failed to remove trigger file: {e}", file=sys.stderr)
            
            # Exit successfully
            sys.exit(0)
            
        print(f"[!] Loop Attempt {attempt} failed under QA: {qa_model} with exit code {val_code}.")
        
        # Write .ai-project/feedback.json on failure
        feedback_data = {
            "epic_id": epic_id,
            "attempt": attempt,
            "max_attempts": MAX_RETRIES,
            "validation_command": validation_cmd,
            "exit_code": val_code,
            "stdout": stdout,
            "stderr": stderr
        }
        try:
            feedback_file.parent.mkdir(parents=True, exist_ok=True)
            with open(feedback_file, 'w') as f:
                json.dump(feedback_data, f, indent=2)
            print(f"[✓] Feedback written to {feedback_file}")
        except Exception as e:
            print(f"[!] Failed to write feedback.json: {e}", file=sys.stderr)
            
        # Run dev_command inside sandbox under epic_dev model configuration
        print(f"[*] Running developer command on failure inside sandbox (active model: {dev_model}): {dev_cmd}")
        dev_code, dev_out, dev_err = run_in_sandbox(sandbox_image, dev_cmd, active_model=dev_model)
        print(f"[*] Developer command on failure finished with exit code: {dev_code}")
        if dev_code != 0:
            print(f"[!] Warning: Developer command failed with exit code {dev_code}", file=sys.stderr)
            
    # If all MAX_RETRIES attempts fail
    print(f"[X] Maximum attempts ({MAX_RETRIES}) exhausted. Generating escalation report...")
    generate_escalation_report(epic_id, stdout, stderr, dev_model, qa_model)
    
    # Retain (or archive) the trigger file to prevent duplicate runs
    trigger_file = QUEUE_DIR / "04_epic.json"
    if trigger_file.exists():
        archived_file = QUEUE_DIR / "04_epic.json.failed"
        try:
            trigger_file.rename(archived_file)
            print(f"[✓] Archived trigger file to {archived_file} to prevent duplicate runs.")
        except Exception as e:
            print(f"[!] Failed to archive trigger file: {e}", file=sys.stderr)
    
    # Exit with status code 1
    sys.exit(1)

def generate_escalation_report(epic_id, stdout, stderr, dev_model, qa_model):
    admin_dir = PROJECT_ROOT / "docs" / "admin"
    admin_dir.mkdir(parents=True, exist_ok=True)
    
    report_path = admin_dir / f"escalation-report-{epic_id}.md"
    report_content = f"""---
epic: {epic_id}
status: blocked
retry_attempts: {MAX_RETRIES}
resolved_under:
  dev: "{dev_model}"
  qa: "{qa_model}"
timestamp: UTC
---

# Escalation Report: Epic {epic_id} Blocked

The autonomous Dev-QA validation loop has exhausted the retry ceiling of {MAX_RETRIES} attempts.

## Hybrid Roles Context
- **Developer Model:** `{dev_model}`
- **QA Tester Model:** `{qa_model}`

## Standard Output Log
```
{stdout}
```

## Standard Error Log
```
{stderr}
```

## Director Intervention Required
Execution on the active branch has been suspended. Please review the failed validation outputs above, resolve any structural code defects, or update the Epic Spec.
"""
    try:
        with open(report_path, 'w') as f:
            f.write(report_content)
        print(f"[✓] Escalation report written to {report_path}")
    except Exception as e:
        print(f"[!] Failed to write escalation report: {e}", file=sys.stderr)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--test":
        import unittest
        from unittest.mock import patch, MagicMock
        import tempfile
        import shutil

        class TestOrchestrator(unittest.TestCase):
            def setUp(self):
                global PROJECT_ROOT, QUEUE_DIR, LOCK_FILE, YML_CONFIG
                
                # Create a temporary directory structure
                self.temp_dir = tempfile.TemporaryDirectory()
                self.project_root_path = Path(self.temp_dir.name)
                
                # Patch the global paths
                self.orig_project_root = PROJECT_ROOT
                self.orig_queue_dir = QUEUE_DIR
                self.orig_lock_file = LOCK_FILE
                self.orig_yml_config = YML_CONFIG
                
                PROJECT_ROOT = self.project_root_path
                QUEUE_DIR = PROJECT_ROOT / ".ai-project" / "queue"
                LOCK_FILE = PROJECT_ROOT / ".ai-project" / "locks" / "execution.lock"
                YML_CONFIG = PROJECT_ROOT / ".ai-project.yml"
                
                # Ensure directories exist
                QUEUE_DIR.mkdir(parents=True, exist_ok=True)
                LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)

            def tearDown(self):
                # Restore the original global paths
                global PROJECT_ROOT, QUEUE_DIR, LOCK_FILE, YML_CONFIG
                PROJECT_ROOT = self.orig_project_root
                QUEUE_DIR = self.orig_queue_dir
                LOCK_FILE = self.orig_lock_file
                YML_CONFIG = self.orig_yml_config
                
                self.temp_dir.cleanup()

            def test_load_yml_config_default(self):
                config = load_yml_config()
                self.assertEqual(config["models"], DEFAULT_MODELS)

            def test_load_yml_config_custom(self):
                custom_config = {
                    "models": {
                        "epic_dev": "custom_dev_model"
                    }
                }
                with open(YML_CONFIG, 'w') as f:
                    yaml.dump(custom_config, f)
                    
                config = load_yml_config()
                self.assertEqual(config["models"]["epic_dev"], "custom_dev_model")
                self.assertEqual(config["models"]["epic_qa"], DEFAULT_MODELS["epic_qa"])

            def test_load_json_trigger(self):
                trigger_data = {"epic_id": "test-epic"}
                trigger_file = QUEUE_DIR / "04_epic.json"
                with open(trigger_file, 'w') as f:
                    json.dump(trigger_data, f)
                    
                loaded = load_json_trigger("04_epic.json")
                self.assertEqual(loaded, trigger_data)

            @patch('subprocess.run')
            def test_run_in_sandbox(self, mock_run):
                mock_run.return_value = MagicMock(returncode=0, stdout="success_out", stderr="")
                code, out, err = run_in_sandbox("mock-image", "test-cmd", "mock-model")
                self.assertEqual(code, 0)
                self.assertEqual(out, "success_out")
                called_args = mock_run.call_args[0][0]
                self.assertIn("docker", called_args)
                self.assertIn("AI_PROJECT_ACTIVE_MODEL=mock-model", called_args)

            @patch('subprocess.run')
            @patch('sys.exit')
            def test_handle_epic_execution_success(self, mock_exit, mock_run):
                mock_exit.side_effect = SystemExit
                trigger = {
                    "epic_id": "EPIC-101",
                    "sandbox_env": "mock-sandbox",
                    "validation_command": "run-validation",
                    "dev_command": "run-dev",
                    "run_dev_initially": False
                }
                trigger_file = QUEUE_DIR / "04_epic.json"
                with open(trigger_file, 'w') as f:
                    json.dump(trigger, f)
                
                mock_run.return_value = MagicMock(returncode=0, stdout="All tests passed", stderr="")
                with self.assertRaises(SystemExit):
                    handle_epic_execution(trigger, DEFAULT_MODELS)
                self.assertFalse(trigger_file.exists())
                mock_exit.assert_called_once_with(0)

            @patch('subprocess.run')
            @patch('sys.exit')
            def test_handle_epic_execution_failure_then_success(self, mock_exit, mock_run):
                mock_exit.side_effect = SystemExit
                trigger = {
                    "epic_id": "EPIC-102",
                    "sandbox_env": "mock-sandbox",
                    "validation_command": "run-validation",
                    "dev_command": "run-dev",
                    "run_dev_initially": False
                }
                trigger_file = QUEUE_DIR / "04_epic.json"
                with open(trigger_file, 'w') as f:
                    json.dump(trigger, f)
                    
                feedback_file = PROJECT_ROOT / ".ai-project" / "feedback.json"
                
                # Mock run returns:
                # 1. Validation fails
                # 2. Dev cmd on failure
                # 3. Dev cmd at start of Attempt 2
                # 4. Validation succeeds
                # 5. Git add
                # 6. Git commit
                run_returns = [
                    MagicMock(returncode=1, stdout="Test fail", stderr="Error log"),
                    MagicMock(returncode=0, stdout="Dev fixed", stderr=""),
                    MagicMock(returncode=0, stdout="Dev ran", stderr=""),
                    MagicMock(returncode=0, stdout="All tests passed", stderr=""),
                    MagicMock(returncode=0, stdout="", stderr=""),
                    MagicMock(returncode=0, stdout="", stderr=""),
                ]
                mock_run.side_effect = run_returns
                
                with self.assertRaises(SystemExit):
                    handle_epic_execution(trigger, DEFAULT_MODELS)
                self.assertFalse(feedback_file.exists())
                self.assertFalse(trigger_file.exists())
                mock_exit.assert_called_once_with(0)

            @patch('subprocess.run')
            @patch('sys.exit')
            def test_handle_epic_execution_max_attempts_exhausted(self, mock_exit, mock_run):
                mock_exit.side_effect = SystemExit
                trigger = {
                    "epic_id": "EPIC-103",
                    "sandbox_env": "mock-sandbox",
                    "validation_command": "run-validation",
                    "dev_command": "run-dev"
                }
                trigger_file = QUEUE_DIR / "04_epic.json"
                with open(trigger_file, 'w') as f:
                    json.dump(trigger, f)
                    
                mock_run.return_value = MagicMock(returncode=1, stdout="Validation failed", stderr="Traceback...")
                
                with self.assertRaises(SystemExit):
                    handle_epic_execution(trigger, DEFAULT_MODELS)
                self.assertFalse(trigger_file.exists())
                archived_file = QUEUE_DIR / "04_epic.json.failed"
                self.assertTrue(archived_file.exists())
                
                report_file = PROJECT_ROOT / "docs" / "admin" / "escalation-report-EPIC-103.md"
                self.assertTrue(report_file.exists())
                
                feedback_file = PROJECT_ROOT / ".ai-project" / "feedback.json"
                self.assertTrue(feedback_file.exists())
                with open(feedback_file, 'r') as f:
                    feedback = json.load(f)
                    self.assertEqual(feedback["epic_id"], "EPIC-103")
                    self.assertEqual(feedback["attempt"], 3)
                    self.assertEqual(feedback["exit_code"], 1)
                    
                mock_exit.assert_called_once_with(1)

        suite = unittest.TestLoader().loadTestsFromTestCase(TestOrchestrator)
        runner = unittest.TextTestRunner(verbosity=2)
        result = runner.run(suite)
        sys.exit(0 if result.wasSuccessful() else 1)

    if LOCK_FILE.exists():
        print("[!] Orchestration execution is locked. Another agent is running. Exiting.")
        sys.exit(1)
        
    os.makedirs(QUEUE_DIR, exist_ok=True)
    os.makedirs(LOCK_FILE.parent, exist_ok=True)
    
    # Discovery of project's hybrid models
    config = load_yml_config()
    models_config = config.get("models", DEFAULT_MODELS)
    
    # Check for Epic triggers
    epic_trigger = load_json_trigger("04_epic.json")
    if epic_trigger:
        LOCK_FILE.touch()
        try:
            handle_epic_execution(epic_trigger, models_config)
        finally:
            if LOCK_FILE.exists():
                LOCK_FILE.unlink()
    else:
        print("[*] No active triggers found in queue.")

if __name__ == "__main__":
    main()

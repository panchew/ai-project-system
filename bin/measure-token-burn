CELL_STATUS = {}
for _g in GAP_RECORDS:
    for _lvl, _task in _g["cells"]:
        CELL_STATUS[(_lvl, _task)] = (_g["status"], _g["id"])


# ---------------------------------------------------------------------------
# Aggregation + report
# ---------------------------------------------------------------------------

def build_matrix(sessions):
    matrix = {}
    for s in sessions:
        cell = matrix.setdefault(s["level"], {}).setdefault(
            s["task_type"],
            {
                "sessions": 0,
                "api_calls": 0,
                "input": 0,
                "cache_creation": 0,
                "cache_read": 0,
                "output": 0,
            },
        )
        cell["sessions"] += 1
        cell["api_calls"] += s["api_calls"]
        for k in ("input", "cache_creation", "cache_read", "output"):
            cell[k] += s["tokens"][k]
    return matrix


def aggregate_models(sessions):
    models = {}
    for s in sessions:
        for model, tok in s["by_model"].items():
            bucket = models.setdefault(
                model, {"input": 0, "cache_creation": 0, "cache_read": 0, "output": 0}
            )
            for k, v in tok.items():
                bucket[k] += v
    return models


def median(values):
    vals = sorted(values)
    if not vals:
        return None
    mid = len(vals) // 2
    return vals[mid] if len(vals) % 2 else (vals[mid - 1] + vals[mid]) // 2


def render_markdown(dataset):
    p = dataset["paid_sessions"]
    matrix = p["matrix_level_x_task"]
    lines = []
    add = lines.append
    add("# Token-Burn Dataset — E30.1 (P9-M30)")
    add("")
    add(f"Generated {dataset['generated_utc']} by `{dataset['script']}` "
        f"v{dataset['script_version']}. **Aggregated numbers only** — no "
        "conversation content. Machine-readable twin: `token-burn-dataset.json`.")
    add("")
    add(f"- Paid source: {p['session_files_scanned']} harness session files, "
        f"{p['sessions_with_usage']} with usage data, window "
        f"{p['coverage_window']['first']} → {p['coverage_window']['last']}.")
    add(f"- Corpus tokenizer: {dataset['tokenizer']}.")
    add("- Spend kinds: `paid` (Anthropic API via Claude Code) vs `local` "
        "(ollama agentic runs) — kept in separate sections, never merged.")
    add("")
    add("## 1. Paid spend — level × task-type matrix")
    add("")
    add("Cell values: `sessions / API calls / output tokens / cache-creation / "
        "cache-read` (input tokens are negligible next to cache figures; full "
        "components per cell in the JSON). Empty cells carry their gap or "
        "structural record — see §6.")
    add("")
    add("| level \\ task | " + " | ".join(TASK_TYPES) + " |")
    add("|---|" + "---|" * len(TASK_TYPES))
    for level in LEVELS:
        row = [f"**{level}**"]
        for task in TASK_TYPES:
            cell = matrix.get(level, {}).get(task)
            if cell:
                row.append(
                    f"n={cell['sessions']}, calls={cell['api_calls']}, "
                    f"out={cell['output']:,}, cc={cell['cache_creation']:,}, "
                    f"cr={cell['cache_read']:,}"
                )
            else:
                status, gid = CELL_STATUS.get(
                    (level, task), ("gap", "G7")
                )
                label = "N/A structural" if status == "structural" else "GAP"
                row.append(f"{label} → {gid}")
        add("| " + " | ".join(row) + " |")
    add("")
    add("### Mixed / unattributed buckets (whole-session totals, split is G7)")
    add("")
    add("| level | bucket | sessions | API calls | output | cache-creation | cache-read |")
    add("|---|---|---|---|---|---|---|")
    for level in LEVELS + ["unattributed"]:
        for task in ("mixed", "unattributed"):
            cell = matrix.get(level, {}).get(task)
            if cell:
                add(
                    f"| {level} | {task} | {cell['sessions']} | "
                    f"{cell['api_calls']} | {cell['output']:,} | "
                    f"{cell['cache_creation']:,} | {cell['cache_read']:,} |"
                )
    add("")
    add("## 2. Paid spend — by model (frontier mix)")
    add("")
    add("| model | input | cache-creation | cache-read | output |")
    add("|---|---|---|---|---|")
    for model, t in sorted(p["by_model"].items()):
        add(
            f"| {model} | {t['input']:,} | {t['cache_creation']:,} | "
            f"{t['cache_read']:,} | {t['output']:,} |"
        )
    add("")
    add("## 3. Measured context load (provider-billed)")
    add("")
    add("| level | first-turn context, median | per-call context, median |")
    add("|---|---|---|")
    for level in LEVELS:
        ft = p["first_turn_context_median_by_level"].get(level)
        pc = p["mean_context_per_call_median_by_level"].get(level)
        add(
            f"| {level} | {ft:,} | {pc:,} |"
            if ft is not None
            else f"| {level} | — | — |"
        )
    add("")
    add("First-turn = input + cache-creation + cache-read of the session's first "
        "API call (system prompt + memory + first message). Per-call = session "
        "context total / API calls (what each call re-reads, mostly cached).")
    add("")
    corpus = dataset.get("corpus_overhead_proxy")
    add("## 4. Governance-corpus overhead (Direction B, proxy tokenizer — G10)")
    add("")
    if corpus:
        add("| file | tokens (o200k proxy) |")
        add("|---|---|")
        for label, n in corpus["files"].items():
            add(f"| {label} | {n:,} |")
        add("")
        add("| directory | tokens | files |")
        add("|---|---|---|")
        for label, v in corpus["directories"].items():
            add(f"| {label} | {v['tokens']:,} | {v['files']} |")
        add("")
        add("Per-level load packs (starter + required specs + PSG + AOG):")
        add("")
        add("| level | pack tokens (o200k proxy) |")
        add("|---|---|")
        for level, v in corpus["level_packs"].items():
            add(f"| {level} | {v['tokens']:,} |")
    else:
        add("Not captured in this run (tokenizer unavailable — rerun with "
            "tiktoken installed).")
    add("")
    add("## 5. Local (ollama) spend — Direction C-lite")
    add("")
    add("Each output-token count is shown with the run-status it is attached to "
        "(exit / status / tool rounds). A per-run number is only as trustworthy "
        "as that status: a `completed`/exit-0 run with 0 rounds is a "
        "**false-positive success** (flagged `zero-work? ⚠`); a non-zero exit "
        "whose work was actually good is a false negative only human review can "
        "confirm (E33.2 exit-code-untrust — gap G11). `exit=GAP` means no "
        "run-metadata file accompanied that transcript.")
    add("")
    add("| run | variant | model | output tokens | prompt tokens | exit | status "
        "| rounds | zero-work? | context.md (proxy) | duration ms |")
    add("|---|---|---|---|---|---|---|---|---|---|---|")
    for r in dataset["local_runs"]:
        zwc = r.get("zero_work_completion")
        zw = "⚠ yes" if zwc else ("no" if zwc is False else "—")
        exit_code = r.get("exit_code")
        exit_cell = "GAP → G11" if exit_code is None else exit_code
        add(
            f"| {r['run']} | {r.get('variant') or '—'} | {r['model']} | "
            f"{r['output_tokens']} | GAP → G9 | {exit_cell} | "
            f"{r.get('status') or '—'} | "
            f"{r.get('iterations') if r.get('iterations') is not None else '—'} | "
            f"{zw} | {r['context_md_tokens_proxy']} | {r['duration_ms']} |"
        )
    add("")
    add("## 6. Gap records (Hard Constraint)")
    add("")
    for g in dataset["gap_records"]:
        cells = (
            "; ".join(f"{l} × {t}" for l, t in g["cells"]) if g["cells"] else "cross-cutting"
        )
        add(f"- **{g['id']}** ({g['status']}; {cells}): {g['record']}")
    add("")
    add("## 7. Per-session aggregates (paid)")
    add("")
    add("Attribution rules are documented in README.md. `level_rule`/`task_rule` "
        "state which rule fired; `branch-fallback` and signal-based rules are "
        "lower-confidence than `first-message`.")
    add("")
    add("| session | date | level (rule) | task (rule) | calls | input | cache-cr | cache-rd | output | first-turn ctx |")
    add("|---|---|---|---|---|---|---|---|---|---|")
    for s in sorted(p["sessions"], key=lambda x: x["date"]):
        t = s["tokens"]
        add(
            f"| {s['session']} | {s['date']} | {s['level']} ({s['level_rule']}) | "
            f"{s['task_type']} ({s['task_rule']}) | {s['api_calls']} | "
            f"{t['input']:,} | {t['cache_creation']:,} | {t['cache_read']:,} | "
            f"{t['output']:,} | {s['first_turn_context_tokens']:,} |"
        )
    add("")
    return "\n".join(lines) + "\n"


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--sessions-dir", default=DEFAULT_SESSIONS_DIR)
    ap.add_argument("--out", default=DEFAULT_OUT)
    ap.add_argument(
        "--no-corpus",
        action="store_true",
        help="skip Direction B (no tokenizer available)",
    )
    args = ap.parse_args(argv)

    counter = None
    tokenizer_desc = "unavailable (Direction B skipped)"
    if not args.no_corpus:
        counter, tokenizer_desc = load_tokenizer()
        if counter is None:
            print(
                "warning: tiktoken not importable — run under a venv with tiktoken "
                "installed, or pass --no-corpus to skip corpus tokenization",
                file=sys.stderr,
            )
            tokenizer_desc = "unavailable (Direction B skipped)"

    sessions = []
    session_files = sorted(glob.glob(os.path.join(args.sessions_dir, "*.jsonl")))
    for path in session_files:
        parsed = parse_session(path)
        if parsed:
            sessions.append(parsed)

    dataset = {
        "generated_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds"
        ),
        "script": "bin/measure-token-burn",
        "script_version": SCRIPT_VERSION,
        "epic": "P9-M30-E30.1",
        "tokenizer": tokenizer_desc,
        "paid_sessions": {
            "source": "Claude Code harness session JSONL usage blocks "
            "(machine-local; aggregated here, never committed raw)",
            "spend_kind": "paid",
            "session_files_scanned": len(session_files),
            "sessions_with_usage": len(sessions),
            "coverage_window": {
                "first": min((s["date"] for s in sessions), default=None),
                "last": max((s["date"] for s in sessions), default=None),
            },
            "sessions": sessions,
            "matrix_level_x_task": build_matrix(sessions),
            "by_model": aggregate_models(sessions),
            "first_turn_context_median_by_level": {
                level: median(
                    [
                        s["first_turn_context_tokens"]
                        for s in sessions
                        if s["level"] == level
                    ]
                )
                for level in LEVELS
            },
            "mean_context_per_call_median_by_level": {
                level: median(
                    [
                        s["mean_context_tokens_per_call"]
                        for s in sessions
                        if s["level"] == level
                    ]
                )
                for level in LEVELS
            },
        },
        "corpus_overhead_proxy": tokenize_corpus(counter) if counter else None,
        "local_runs": collect_local_runs(counter),
        "gap_records": GAP_RECORDS,
    }

    os.makedirs(args.out, exist_ok=True)
    json_path = os.path.join(args.out, "token-burn-dataset.json")
    with open(json_path, "w") as fh:
        json.dump(dataset, fh, indent=2)
        fh.write("\n")
    md_path = os.path.join(args.out, "token-burn-dataset.md")
    with open(md_path, "w") as fh:
        fh.write(render_markdown(dataset))
    print(f"wrote {os.path.relpath(json_path, REPO_ROOT)}")
    print(f"wrote {os.path.relpath(md_path, REPO_ROOT)}")
    print(
        f"  sessions: {len(sessions)} attributed "
        f"({sum(1 for s in sessions if s['level'] == 'unattributed')} unattributed)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

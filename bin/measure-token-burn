#!/usr/bin/env python3
"""measure-token-burn — E30.1 token-burn measurement mechanism (P9-M30).

Hybrid mechanism (see .ai-project/artifacts/reference/token-measurement/README.md):

  (A) Paid spend   — parses Claude Code harness session JSONL files (machine-local,
                     never committed) and aggregates provider-reported ``usage``
                     blocks per session, attributed to chat level and task type by
                     the documented rules below.
  (B) Corpus size  — tokenizes the governance corpus, per-level starter packs, and
                     agentic-run context files with a local tokenizer (tiktoken
                     o200k_base) as a documented proxy for billed counts.
  (C) Local spend  — extracts ollama token counts from the committed agentic-run
                     transcripts (no changes to bin/run-dev-agent). Handles both
                     the single-transcript PROVE layout and the newer per-model
                     layout (``transcript-<tag>.json`` + optional
                     ``transcript-<tag>__run-metadata.json``, one per model), and
                     records the run-status each token count is attached to
                     (exit code / status / tool rounds) so a per-run number is
                     never trusted apart from whether its run actually did the
                     work — the E33.2 "exit-code-untrust" finding (P10-M33-E33.3).

Privacy contract: the emitted dataset carries aggregated token numbers and
attribution labels only. Raw transcripts and conversation content never leave the
machine-local session directory. The only session-derived strings that are read are
the first user message head (for classification, discarded after matching) and
Write/Edit tool-call file paths (for task-type signals, only counted).

Usage:
  bin/measure-token-burn [--sessions-dir DIR] [--out DIR] [--no-corpus]

Outputs (aggregates only):
  <out>/token-burn-dataset.json   machine-readable dataset (E30.2's input)
  <out>/token-burn-dataset.md     human-readable matrix + gap records
"""

import argparse
import datetime
import glob
import json
import os
import re
import sys

SCRIPT_VERSION = "1.1.0"
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_SESSIONS_DIR = os.path.expanduser(
    "~/.claude/projects/-home-panchew-soft-dev-ai-project-system"
)
DEFAULT_OUT = os.path.join(
    REPO_ROOT, ".ai-project", "artifacts", "reference", "token-measurement"
)

LEVELS = ["creation", "hq", "phase", "milestone", "epic"]
TASK_TYPES = ["planning", "execution", "review", "closure"]

# ---------------------------------------------------------------------------
# Attribution rules (Direction A) — documented in the mechanism README.
# Level: matched against the first non-sidechain user message (wrappers stripped),
# falling back to the session's git branch prefix. Task type: role- and
# signal-based; sessions that span several task types are bucketed as "mixed"
# rather than guessed into a single cell (Hard Constraint).
# ---------------------------------------------------------------------------

WRAPPER_RE = re.compile(
    r"<system-reminder>.*?</system-reminder>"
    r"|<ide_opened_file>.*?</ide_opened_file>"
    r"|<ide_selection>.*?</ide_selection>"
    r"|<local-command-caveat>.*?</local-command-caveat>",
    re.S,
)

LEVEL_RULES = [
    ("epic", re.compile(r"epic execution chat starter", re.I)),
    ("epic", re.compile(r"^phase\s+p\d+\s+milestone\s+m?\d+\s+(?:epic\s+)?e\d+", re.I)),
    ("epic", re.compile(r"^epic\s+e\d+", re.I)),
    ("milestone", re.compile(r"milestone execution chat starter", re.I)),
    ("milestone", re.compile(r"^phase\s+p\d+\s+milestone\s+m?\d+\b", re.I)),
    ("phase", re.compile(r"phase execution chat starter", re.I)),
    ("phase", re.compile(r"^phase\s+p\d+\b", re.I)),
    ("hq", re.compile(r"artifact_type:\s*hq_opener|hq chat opener", re.I)),
    ("creation", re.compile(r"artifact_type:\s*seed", re.I)),
]

BRANCH_LEVELS = [("epic/", "epic"), ("milestone/", "milestone"), ("phase/", "phase")]

SIGNAL_PATTERNS = {
    "spec_writes": re.compile(r"__spec__|milestone-spec|phase-spec"),
    "starter_writes": re.compile(r"chat-starter|starter\.md", re.I),
    "delivery_notice_writes": re.compile(r"delivery-notice"),
    "closure_writes": re.compile(r"closure-declaration"),
    "review_decision_writes": re.compile(r"review-decision"),
}


def classify_level(first_user_text, branch):
    for level, pat in LEVEL_RULES:
        if pat.search(first_user_text):
            return level, "first-message"
    for prefix, level in BRANCH_LEVELS:
        if (branch or "").startswith(prefix):
            return level, "branch-fallback"
    return "unattributed", "none"


def classify_task(level, level_rule, first_user_text, signals):
    if re.match(r"^review\b", first_user_text, re.I):
        # A "Review …" opener is the parent chat reviewing a delivery; level
        # comes from the branch fallback (the reviewer's branch), task is review.
        return "review", "first-message"
    if level == "epic" and level_rule == "first-message":
        # Epic chats execute end-to-end (incl. Delivery Notice authoring);
        # planning/review of epics happens in parent chats. Branch-inferred
        # epic sessions are NOT assumed to be executions — signals decide.
        return "execution", "role"
    active = {
        "planning": signals["spec_writes"] + signals["starter_writes"],
        "review": signals["review_decision_writes"],
        "closure": signals["closure_writes"],
        "delivery_handling": signals["delivery_notice_writes"],
    }
    present = [k for k, v in active.items() if v > 0]
    if present == ["planning"]:
        return "planning", "signals"
    if not present:
        return "unattributed", "no-signals"
    return "mixed", "signals:" + "+".join(present)


# ---------------------------------------------------------------------------
# Direction A — harness session parsing
# ---------------------------------------------------------------------------

def parse_session(path):
    seen_ids = set()
    totals = {"input": 0, "cache_creation": 0, "cache_read": 0, "output": 0}
    by_model = {}
    api_calls = 0
    sidechain_calls = 0
    first_turn_context = None
    branch = None
    entrypoint = None
    t_first = None
    t_last = None
    first_user_text = None
    signals = {k: 0 for k in SIGNAL_PATTERNS}

    with open(path) as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                continue
            rtype = rec.get("type")
            if rtype == "user" and first_user_text is None and not rec.get("isSidechain"):
                content = rec.get("message", {}).get("content")
                if isinstance(content, str):
                    text = content
                else:
                    text = " ".join(
                        b.get("text", "")
                        for b in (content or [])
                        if isinstance(b, dict) and b.get("type") == "text"
                    )
                text = " ".join(WRAPPER_RE.sub("", text).split())
                if text:
                    first_user_text = text[:200]
            if rtype != "assistant":
                continue
            msg = rec.get("message", {})
            if msg.get("model") == "<synthetic>":
                continue
            usage = msg.get("usage")
            if not usage:
                continue
            # Claude Code writes one JSONL line per content block, so tool-use
            # signals must be scanned on every line — but each line repeats the
            # same message id and usage, so usage is counted once per message.
            for block in msg.get("content") or []:
                if (
                    isinstance(block, dict)
                    and block.get("type") == "tool_use"
                    and block.get("name") in ("Write", "Edit", "MultiEdit")
                ):
                    fpath = str(block.get("input", {}).get("file_path", ""))
                    for key, pat in SIGNAL_PATTERNS.items():
                        if pat.search(fpath):
                            signals[key] += 1
            mid = msg.get("id")
            if mid in seen_ids:
                continue
            seen_ids.add(mid)
            api_calls += 1
            if rec.get("isSidechain"):
                sidechain_calls += 1
            call = {
                "input": usage.get("input_tokens") or 0,
                "cache_creation": usage.get("cache_creation_input_tokens") or 0,
                "cache_read": usage.get("cache_read_input_tokens") or 0,
                "output": usage.get("output_tokens") or 0,
            }
            for k, v in call.items():
                totals[k] += v
            model = msg.get("model") or "unknown"
            bucket = by_model.setdefault(model, dict.fromkeys(totals, 0))
            for k, v in call.items():
                bucket[k] += v
            if first_turn_context is None:
                first_turn_context = (
                    call["input"] + call["cache_creation"] + call["cache_read"]
                )
            branch = branch or rec.get("gitBranch")
            entrypoint = entrypoint or rec.get("entrypoint")
            ts = rec.get("timestamp")
            if ts:
                t_first = t_first or ts
                t_last = ts

    if api_calls == 0:
        return None
    first_user_text = first_user_text or ""
    level, level_rule = classify_level(first_user_text, branch)
    task, task_rule = classify_task(level, level_rule, first_user_text, signals)
    context_per_call = (
        totals["input"] + totals["cache_creation"] + totals["cache_read"]
    ) // api_calls
    return {
        "session": os.path.basename(path)[:8],
        "date": (t_first or "")[:10],
        "branch": branch,
        "entrypoint": entrypoint,
        "level": level,
        "level_rule": level_rule,
        "task_type": task,
        "task_rule": task_rule,
        "api_calls": api_calls,
        "sidechain_calls": sidechain_calls,
        "tokens": totals,
        "by_model": by_model,
        "first_turn_context_tokens": first_turn_context,
        "mean_context_tokens_per_call": context_per_call,
        "artifact_write_signals": signals,
    }


# ---------------------------------------------------------------------------
# Direction B — corpus tokenization (local proxy tokenizer)
# ---------------------------------------------------------------------------

def load_tokenizer():
    try:
        import tiktoken  # type: ignore

        enc = tiktoken.get_encoding("o200k_base")
        return (
            lambda text: len(enc.encode(text, disallowed_special=())),
            "tiktoken/o200k_base (proxy for the Claude tokenizer; see README error bars)",
        )
    except ImportError:
        return None, None


def count_file(counter, path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return counter(fh.read())
    except OSError:
        return None


def tokenize_corpus(counter):
    gov = os.path.join(REPO_ROOT, "governance")
    p9 = os.path.join(
        REPO_ROOT, "docs", "phases", "P9__Context_Handling_and_Token_Efficiency"
    )
    files = {
        "PSG (PROJECT-SYSTEM-GUIDELINES.md)": os.path.join(gov, "PROJECT-SYSTEM-GUIDELINES.md"),
        "AOG (AI-OPERATING-GUIDELINES.md)": os.path.join(gov, "AI-OPERATING-GUIDELINES.md"),
        "yml spec (ai-project-yml-spec.md)": os.path.join(gov, "ai-project-yml-spec.md"),
        "generic epic starter (governance/EPIC-EXECUTION-CHAT-STARTER.md)": os.path.join(
            gov, "EPIC-EXECUTION-CHAT-STARTER.md"
        ),
        "P9 phase starter": os.path.join(p9, "P9__phase-execution-chat-starter.md"),
        "P9 phase spec": os.path.join(p9, "P9__phase-spec.md"),
        "M30 milestone starter": os.path.join(p9, "P9-M30__milestone-execution-chat-starter.md"),
        "M30 milestone spec": os.path.join(p9, "P9-M30__milestone-spec.md"),
        "E30.1 epic starter": os.path.join(p9, "P9-M30-E30.1__epic-execution-chat-starter.md"),
        "E30.1 epic spec": os.path.join(p9, "P9-M30-E30.1__spec__token-burn-instrumentation.md"),
    }
    out = {"files": {}, "directories": {}, "level_packs": {}}
    for label, path in files.items():
        n = count_file(counter, path)
        if n is not None:
            out["files"][label] = n
    for label, sub in [
        ("governance/ total (*.md recursive)", gov),
        ("governance/templates", os.path.join(gov, "templates")),
        ("governance/systems", os.path.join(gov, "systems")),
    ]:
        total = 0
        nfiles = 0
        for path in glob.glob(os.path.join(sub, "**", "*.md"), recursive=True):
            n = count_file(counter, path)
            if n is not None:
                total += n
                nfiles += 1
        out["directories"][label] = {"tokens": total, "files": nfiles}

    f = out["files"]

    def pack(*labels):
        vals = [f[l] for l in labels if l in f]
        return {"tokens": sum(vals), "components": {l: f[l] for l in labels if l in f}}

    core = ["PSG (PROJECT-SYSTEM-GUIDELINES.md)", "AOG (AI-OPERATING-GUIDELINES.md)"]
    out["level_packs"] = {
        "phase": pack("P9 phase starter", "P9 phase spec", *core),
        "milestone": pack(
            "M30 milestone starter", "M30 milestone spec", "P9 phase spec", *core
        ),
        "epic": pack("E30.1 epic starter", "E30.1 epic spec", *core),
    }
    return out


# ---------------------------------------------------------------------------
# Direction C (lite) — local agentic-run extraction
# ---------------------------------------------------------------------------

def _load_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (ValueError, OSError):
        return None


def _build_run_entry(run_name, variant, transcript_path, rmeta, ctx_tokens):
    """Assemble one local-run record from its transcript and (optional) metadata.

    ``rmeta`` may be None when a transcript carries no sibling run-metadata file
    (E33.2's Run B) — the exit code is then a recorded gap, not fabricated. The
    token count is captured together with the run-status it is attached to
    (exit / status / tool rounds), because a per-run number is only as
    trustworthy as whether the run actually did the work (exit-code-untrust; see
    gap G11). ``zero_work_completion`` is the one case this can decide
    mechanically — a ``completed``/0-round run is a false-positive success; the
    mirror false-negative (non-zero exit with good work) needs human review and
    is left to G11, not guessed.
    """
    rmeta = rmeta or {}
    entry = {
        "run": run_name,
        "variant": variant,  # None for the single-transcript PROVE layout
        "model": rmeta.get("model"),
        "spend_kind": "local",
        "output_tokens": None,
        "prompt_tokens": None,  # not recorded by the runner — gap (G9)
        "context_md_tokens_proxy": ctx_tokens,
        "duration_ms": rmeta.get("duration_ms"),
        # Run-status the token count is attached to (exit-code-untrust — G11).
        "exit_code": rmeta.get("exit_code"),  # None => no metadata file (gap)
        "run_metadata_present": bool(rmeta),
        "status": None,
        "iterations": None,
        "zero_work_completion": None,
    }
    transcript = _load_json(transcript_path) if transcript_path else None
    if transcript:
        # Prefer the runner's own reported total (includes the final answer
        # turn); fall back to summing per-turn eval_count.
        if isinstance(transcript.get("tokens"), int):
            entry["output_tokens"] = transcript["tokens"]
        else:
            turns = transcript.get("transcript") or []
            evals = [
                t.get("eval_count")
                for t in turns
                if isinstance(t, dict) and isinstance(t.get("eval_count"), int)
            ]
            if evals:
                entry["output_tokens"] = sum(evals)
        entry["status"] = transcript.get("status")
        it = transcript.get("iterations")
        entry["iterations"] = it if isinstance(it, int) else None
        # Fall back to transcript-reported model/duration when metadata is absent.
        if entry["model"] is None:
            entry["model"] = transcript.get("model")
        if entry["duration_ms"] is None:
            entry["duration_ms"] = transcript.get("duration_ms")
        if entry["status"] is not None and entry["iterations"] is not None:
            entry["zero_work_completion"] = (
                entry["status"] == "completed" and entry["iterations"] == 0
            )
    return entry


def collect_local_runs(counter):
    runs = []
    base = os.path.join(REPO_ROOT, ".ai-project", "artifacts", "agentic-runs")
    for run_dir in sorted(glob.glob(os.path.join(base, "*"))):
        if not os.path.isdir(run_dir):
            continue
        run_name = os.path.basename(run_dir)
        ctx = os.path.join(run_dir, "context.md")
        ctx_tokens = (
            count_file(counter, ctx) if counter and os.path.isfile(ctx) else None
        )
        legacy_tr = os.path.join(run_dir, "transcript.json")
        legacy_rm = os.path.join(run_dir, "run-metadata.json")
        if os.path.isfile(legacy_tr) or os.path.isfile(legacy_rm):
            # Single-transcript PROVE layout (P7-M26/P9-M31): one run per dir.
            rmeta = _load_json(legacy_rm) if os.path.isfile(legacy_rm) else None
            runs.append(
                _build_run_entry(run_name, None, legacy_tr, rmeta, ctx_tokens)
            )
            continue
        # Newer per-model layout (E33.2+): one transcript file per model, named
        # transcript-<tag>.json, each with an OPTIONAL sibling
        # transcript-<tag>__run-metadata.json (Run B carries none — that becomes
        # a recorded exit-code gap, not a skipped run).
        transcripts = sorted(
            p
            for p in glob.glob(os.path.join(run_dir, "transcript-*.json"))
            if not p.endswith("__run-metadata.json")
        )
        for tr_path in transcripts:
            stem = os.path.basename(tr_path)[: -len(".json")]
            variant = (
                stem[len("transcript-") :]
                if stem.startswith("transcript-")
                else stem
            )
            rm_path = os.path.join(run_dir, stem + "__run-metadata.json")
            rmeta = _load_json(rm_path) if os.path.isfile(rm_path) else None
            runs.append(
                _build_run_entry(run_name, variant, tr_path, rmeta, ctx_tokens)
            )
    return runs



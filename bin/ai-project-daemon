#!/usr/bin/env python3
import os
import sys
import signal
import time
import errno
import tempfile
import unittest
import io
from pathlib import Path

# Paths
PROJECT_ROOT = Path(__file__).resolve().parent.parent
LOCK_FILE = PROJECT_ROOT / ".ai-project" / "locks" / "daemon.pid"
LOG_FILE = PROJECT_ROOT / ".ai-project" / "logs" / "daemon.log"

def check_pid_alive(pid):
    """Check if process with pid is running."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError as err:
        if err.errno == errno.EPERM:
            return True
        elif err.errno == errno.ESRCH:
            return False
        else:
            raise

def get_daemon_pid():
    """Reads and returns the PID from the lock file if it exists."""
    if not LOCK_FILE.exists():
        return None
    try:
        with open(LOCK_FILE, 'r') as f:
            content = f.read().strip()
        if not content:
            return None
        return int(content)
    except Exception:
        return None

def handle_signal(signum, frame):
    """Signal handler for graceful shutdown."""
    print(f"\n[!] Daemon received signal {signum}. Cleaning up and exiting...", flush=True)
    if LOCK_FILE.exists():
        try:
            LOCK_FILE.unlink()
            print("[✓] Daemon PID lockfile removed successfully.", flush=True)
        except Exception as e:
            print(f"[!] Failed to remove PID lockfile: {e}", file=sys.stderr, flush=True)
    sys.exit(0)

def daemonize():
    """Double-fork daemonization with pipe synchronization."""
    sys.stdout.flush()
    sys.stderr.flush()

    pipe_r, pipe_w = os.pipe()

    try:
        pid = os.fork()
        if pid > 0:
            # First parent
            os.close(pipe_w)
            try:
                grandchild_bytes = os.read(pipe_r, 16)
                if grandchild_bytes:
                    grandchild_pid = int(grandchild_bytes.decode().strip())
                    print(f"[✓] Daemon started (PID: {grandchild_pid})")
                    sys.exit(0)
                else:
                    print("[!] Daemon startup failed during initialization.", file=sys.stderr)
                    sys.exit(1)
            except Exception as e:
                print(f"[!] Daemon startup failed: {e}", file=sys.stderr)
                sys.exit(1)
    except OSError as e:
        sys.stderr.write(f"Fork #1 failed: {e}\n")
        sys.exit(1)

    # First child
    os.close(pipe_r)
    os.setsid()
    os.umask(0)

    try:
        pid = os.fork()
        if pid > 0:
            sys.exit(0)
    except OSError as e:
        sys.stderr.write(f"Fork #2 failed: {e}\n")
        sys.exit(1)

    # Second child (Daemon)
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)

    my_pid = os.getpid()

    # Write PID to lock file
    try:
        with open(LOCK_FILE, 'w') as f:
            f.write(str(my_pid))
    except Exception as e:
        sys.exit(1)

    # Notify parent of the PID
    try:
        os.write(pipe_w, f"{my_pid}".encode())
    except Exception:
        pass
    finally:
        os.close(pipe_w)

    # Redirect standard streams
    try:
        log_fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        dev_null_fd = os.open(os.devnull, os.O_RDONLY)
        os.dup2(dev_null_fd, 0)
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)
    except Exception:
        sys.exit(1)

def run_daemon_loop():
    """Runs the background loop of the daemon."""
    # Register signal handlers for clean lock file removal
    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    print(f"[*] Daemon loop started (PID: {os.getpid()})", flush=True)
    try:
        while True:
            print("[INFO] Daemon heartbeat...", flush=True)
            time.sleep(10)
    except Exception as e:
        print(f"[!] Unexpected error in daemon loop: {e}", file=sys.stderr, flush=True)
        if LOCK_FILE.exists():
            try:
                LOCK_FILE.unlink()
            except Exception:
                pass
        sys.exit(1)

def cmd_start():
    pid = get_daemon_pid()
    if pid is not None and check_pid_alive(pid):
        print(f"[!] Daemon is already running (PID: {pid}).", file=sys.stderr)
        sys.exit(1)
    elif pid is not None:
        print(f"[!] Warning: Stale lockfile found with dead PID {pid}. Recovering and deleting stale lock...", file=sys.stderr)
        try:
            LOCK_FILE.unlink()
        except Exception:
            pass

    print("[*] Starting background daemon...")
    daemonize()
    run_daemon_loop()

def cmd_stop():
    pid = get_daemon_pid()
    if pid is None or not check_pid_alive(pid):
        if LOCK_FILE.exists():
            print("[!] Daemon is not running, but stale lockfile found. Cleaning up lockfile.", file=sys.stderr)
            try:
                LOCK_FILE.unlink()
            except Exception:
                pass
            sys.exit(0)
        else:
            print("[!] Daemon is not running.", file=sys.stderr)
            sys.exit(1)

    print(f"[*] Stopping daemon (PID: {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as e:
        print(f"[!] Failed to send SIGTERM to daemon: {e}", file=sys.stderr)
        sys.exit(1)

    # Wait for the daemon to terminate and clean up its lock file (up to 5 seconds)
    stopped = False
    for _ in range(50):
        if not check_pid_alive(pid) and not LOCK_FILE.exists():
            stopped = True
            break
        time.sleep(0.1)

    if stopped:
        print("[✓] Daemon stopped.")
        sys.exit(0)
    else:
        print("[!] Daemon did not stop within 5 seconds. Forcing shutdown...", file=sys.stderr)
        try:
            os.kill(pid, signal.SIGKILL)
            if LOCK_FILE.exists():
                LOCK_FILE.unlink()
            print("[✓] Daemon force killed.")
            sys.exit(0)
        except Exception as e:
            print(f"[!] Failed to force kill daemon: {e}", file=sys.stderr)
            sys.exit(1)

def cmd_status():
    pid = get_daemon_pid()
    if pid is not None and check_pid_alive(pid):
        print(f"Daemon is running (PID: {pid})")
        sys.exit(0)
    elif pid is not None:
        print("Daemon is dead but stale PID lock file exists.")
        sys.exit(0)
    else:
        print("Daemon is stopped")
        sys.exit(0)

def cmd_logs():
    if not LOG_FILE.exists():
        print("[*] No log file found.")
        sys.exit(0)
    try:
        with open(LOG_FILE, 'r') as f:
            print(f.read(), end="")
        sys.exit(0)
    except Exception as e:
        print(f"[!] Failed to read log file: {e}", file=sys.stderr)
        sys.exit(1)

def print_help():
    print("""ai-project-daemon - CLI Daemon Process & Control Suite

Usage:
  ai-project-daemon start   - Starts the background daemon process
  ai-project-daemon stop    - Stops the running background daemon process
  ai-project-daemon status  - Displays the running status of the daemon
  ai-project-daemon logs    - Outputs the background daemon logs
  ai-project-daemon --test  - Runs the embedded test suite
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)

    command = sys.argv[1]

    if command == "--test":
        from unittest.mock import patch, MagicMock

        class TestDaemon(unittest.TestCase):
            def setUp(self):
                global PROJECT_ROOT, LOCK_FILE, LOG_FILE
                self.temp_dir = tempfile.TemporaryDirectory()
                self.project_root_path = Path(self.temp_dir.name)
                
                self.orig_project_root = PROJECT_ROOT
                self.orig_lock_file = LOCK_FILE
                self.orig_log_file = LOG_FILE
                
                PROJECT_ROOT = self.project_root_path
                LOCK_FILE = PROJECT_ROOT / ".ai-project" / "locks" / "daemon.pid"
                LOG_FILE = PROJECT_ROOT / ".ai-project" / "logs" / "daemon.log"
                
                LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
                LOG_FILE.parent.mkdir(parents=True, exist_ok=True)

            def tearDown(self):
                global PROJECT_ROOT, LOCK_FILE, LOG_FILE
                PROJECT_ROOT = self.orig_project_root
                LOCK_FILE = self.orig_lock_file
                LOG_FILE = self.orig_log_file
                self.temp_dir.cleanup()

            def test_get_daemon_pid_none(self):
                self.assertIsNone(get_daemon_pid())

            def test_get_daemon_pid_valid(self):
                with open(LOCK_FILE, 'w') as f:
                    f.write("12345")
                self.assertEqual(get_daemon_pid(), 12345)

            def test_get_daemon_pid_invalid(self):
                with open(LOCK_FILE, 'w') as f:
                    f.write("abc")
                self.assertIsNone(get_daemon_pid())

            @patch('os.kill')
            def test_check_pid_alive_running(self, mock_kill):
                mock_kill.return_value = None
                self.assertTrue(check_pid_alive(12345))
                mock_kill.assert_called_once_with(12345, 0)

            @patch('os.kill')
            def test_check_pid_alive_dead(self, mock_kill):
                mock_kill.side_effect = OSError(errno.ESRCH, "No such process")
                self.assertFalse(check_pid_alive(12345))

            @patch('os.kill')
            def test_check_pid_alive_permission(self, mock_kill):
                mock_kill.side_effect = OSError(errno.EPERM, "Operation not permitted")
                self.assertTrue(check_pid_alive(12345))

            @patch('os.fork')
            @patch('os.setsid')
            @patch('os.umask')
            @patch('os.open')
            @patch('os.dup2')
            @patch('os.close')
            @patch('os.write')
            @patch('os.read')
            def test_daemonize_parent(self, mock_read, mock_write, mock_close, mock_dup2, mock_open, mock_umask, mock_setsid, mock_fork):
                mock_fork.return_value = 5555
                mock_read.return_value = b"5556"
                
                with self.assertRaises(SystemExit) as cm:
                    daemonize()
                self.assertEqual(cm.exception.code, 0)

            @patch('os.fork')
            @patch('os.setsid')
            @patch('os.umask')
            @patch('os.open')
            @patch('os.dup2')
            @patch('os.close')
            @patch('os.write')
            @patch('os.read')
            def test_daemonize_child(self, mock_read, mock_write, mock_close, mock_dup2, mock_open, mock_umask, mock_setsid, mock_fork):
                mock_fork.side_effect = [0, 0]
                daemonize()
                self.assertTrue(LOCK_FILE.exists())
                with open(LOCK_FILE, 'r') as f:
                    content = f.read()
                self.assertEqual(int(content), os.getpid())

            @patch('sys.exit')
            def test_cmd_status_stopped(self, mock_exit):
                with patch('sys.stdout', new_callable=io.StringIO) as mock_stdout:
                    cmd_status()
                    output = mock_stdout.getvalue()
                    self.assertIn("Daemon is stopped", output)

            @patch('sys.exit')
            def test_cmd_status_running(self, mock_exit):
                with open(LOCK_FILE, 'w') as f:
                    f.write("99999")
                with patch('os.kill') as mock_kill:
                    mock_kill.return_value = None
                    with patch('sys.stdout', new_callable=io.StringIO) as mock_stdout:
                        cmd_status()
                        output = mock_stdout.getvalue()
                        self.assertIn("Daemon is running (PID: 99999)", output)

            @patch('sys.exit')
            def test_cmd_status_stale(self, mock_exit):
                with open(LOCK_FILE, 'w') as f:
                    f.write("99999")
                with patch('os.kill') as mock_kill:
                    mock_kill.side_effect = OSError(errno.ESRCH, "No such process")
                    with patch('sys.stdout', new_callable=io.StringIO) as mock_stdout:
                        cmd_status()
                        output = mock_stdout.getvalue()
                        self.assertIn("Daemon is dead but stale PID lock file exists", output)

            @patch('sys.exit')
            def test_cmd_stop_not_running(self, mock_exit):
                def exit_side_effect(code=0):
                    raise SystemExit(code)
                mock_exit.side_effect = exit_side_effect
                with self.assertRaises(SystemExit) as cm:
                    cmd_stop()
                self.assertEqual(cm.exception.code, 1)

            @patch('sys.exit')
            @patch('os.kill')
            def test_cmd_stop_success(self, mock_kill, mock_exit):
                def exit_side_effect(code=0):
                    raise SystemExit(code)
                mock_exit.side_effect = exit_side_effect

                with open(LOCK_FILE, 'w') as f:
                    f.write("88888")
                
                check_alive_mock = MagicMock(side_effect=[True, False])
                
                def kill_side_effect(pid, sig):
                    if LOCK_FILE.exists():
                        LOCK_FILE.unlink()
                    return None
                mock_kill.side_effect = kill_side_effect

                with patch('__main__.check_pid_alive', check_alive_mock):
                    with self.assertRaises(SystemExit) as cm:
                        cmd_stop()
                    self.assertEqual(cm.exception.code, 0)

            def test_signal_handler(self):
                with open(LOCK_FILE, 'w') as f:
                    f.write("11111")
                self.assertTrue(LOCK_FILE.exists())
                with self.assertRaises(SystemExit):
                    handle_signal(signal.SIGTERM, None)
                self.assertFalse(LOCK_FILE.exists())

        suite = unittest.TestLoader().loadTestsFromTestCase(TestDaemon)
        runner = unittest.TextTestRunner(verbosity=2)
        result = runner.run(suite)
        sys.exit(0 if result.wasSuccessful() else 1)

    elif command == "start":
        cmd_start()
    elif command == "stop":
        cmd_stop()
    elif command == "status":
        cmd_status()
    elif command == "logs":
        cmd_logs()
    else:
        print(f"[!] Unknown command: {command}", file=sys.stderr)
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
